# ==============================================================================
# ComicPay — Unified Node.js + Express + discord.js + Supabase PostgreSQL
# Copy this file to .env and fill in real values. NEVER commit .env!
# ==============================================================================

# --- Runtime & Server ---
NODE_ENV=production
PORT=3000
APP_URL="https://your-dashboard-domain.com"
ALLOWED_ORIGINS="https://your-dashboard-domain.com,http://localhost:3000"
TIMEZONE="Asia/Jakarta"

# --- Security & JWT (REQUIRED IN PRODUCTION) ---
# Generate with: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_SECRET"
# Optional one-time token protecting initial Owner setup UI: openssl rand -hex 24
SETUP_TOKEN="REPLACE_WITH_INITIAL_OWNER_SETUP_TOKEN"
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180

# --- Supabase PostgreSQL (REQUIRED IN PRODUCTION) ---
# Direct or Transaction Pooler connection string from Supabase Project Settings -> Database
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Set to "false" only for local self-hosted Postgres without SSL
DATABASE_SSL="true"

# --- Supabase Auth (Server & Optional Frontend JWT Integration) ---
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_NEVER_EXPOSE_TO_FRONTEND"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# --- Frontend Public Env (Safe for Browser) ---
VITE_APP_NAME="ComicPay"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Discord Bot Configuration (discord.js Gateway) ---
# Enable Message Content Intent + Server Members Intent in Discord Developer Portal
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_GUILD_ID="YOUR_DISCORD_GUILD_ID"
DISCORD_NOTIFICATION_CHANNEL_ID="YOUR_DISCORD_NOTIFICATION_CHANNEL_ID"
DISCORD_ADMIN_ROLE_IDS="ROLE_ID_1,ROLE_ID_2"
DISCORD_ADMIN_USER_IDS="USER_ID_1,USER_ID_2"

# --- Automated Encrypted Off-Site PostgreSQL Backup ---
BACKUP_ENCRYPTION_PASSPHRASE="REPLACE_WITH_STRONG_PASSPHRASE"
BACKUP_REMOTE_TARGET="rclone-remote:comicpay-backups"
BACKUP_RETENTION_DAYS=30
